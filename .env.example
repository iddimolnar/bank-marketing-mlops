# Example environment configuration. Copy to `.env` and fill in real values.
# NEVER commit the real .env (it is git-ignored).

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=bank-marketing
MLFLOW_REGISTERED_MODEL_NAME=bank-marketing-clf

# --- MinIO / S3 artifact store (used by MLflow) ---
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Application ---
BANK_DROP_DURATION=true
BANK_GATE_METRIC=roc_auc
BANK_GATE_TOLERANCE=0.0
BANK_RANDOM_STATE=42